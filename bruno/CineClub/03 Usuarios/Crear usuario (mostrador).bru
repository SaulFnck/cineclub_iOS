meta {
  name: Crear usuario (mostrador)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombreCompleto": "Cliente Mostrador",
    "correo": "mostrador@cineclub.com",
    "password": "1234"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("idUsuario", res.body.idUsuario);
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
