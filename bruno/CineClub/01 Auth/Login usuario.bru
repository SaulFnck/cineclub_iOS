meta {
  name: Login usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "bruno.usuario@cineclub.com",
    "password": "1234"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("idUsuario", res.body.id);
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
