meta {
  name: Registro usuario
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombreCompleto": "Usuario Bruno",
    "correo": "bruno.usuario@cineclub.com",
    "password": "1234"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("idUsuario", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
