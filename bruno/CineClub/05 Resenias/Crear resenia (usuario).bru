meta {
  name: Crear resenia (usuario)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/resenias
  body: json
  auth: none
}

body:json {
  {
    "idPelicula": {{idPelicula}},
    "idUsuario": {{idUsuario}},
    "comentario": "Muy buena, la recomiendo",
    "rating": 5
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("idResenia", res.body.idResenia);
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
