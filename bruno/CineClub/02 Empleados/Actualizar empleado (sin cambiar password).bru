meta {
  name: Actualizar empleado (sin cambiar password)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/empleados/{{idEmpleado}}
  body: json
  auth: none
}

body:json {
  {
    "nombreCompleto": "Empleado Bruno Editado",
    "correo": "bruno.empleado@cineclub.com"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}
